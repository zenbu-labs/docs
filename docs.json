{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zenbu.js",
  "colors": {
    "primary": "#18181B",
    "light": "#71717A",
    "dark": "#18181B"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://zenbu.dev"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "navbar": {
    "links": []
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zenbu-labs/zenbu",
      "discord": "https://discord.gg/t3jzHHfc6z"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart",
          "concepts"
        ]
      },
      {
        "group": "Core",
        "pages": [
          "core/services",
          "core/state",
          "core/rpc",
          "core/events",
          "core/views",
          "core/content-scripts",
          "core/advice",
          "core/plugins"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/production"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/overview"
        ]
      }
    ]
  },
  "css": "/custom.css",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
